{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tandix.dev/schemas/agent-skill.v1.json",
  "title": "Tandix agent skill",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "id", "name", "goal", "steps", "success", "parameters", "allowedOrigins", "sourceSessionId", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "tandix.agent-skill/v1" },
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "steps": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "success": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "parameters": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "label", "type", "required"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "type": { "enum": ["string", "secret", "number", "boolean"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "allowedOrigins": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^https?://[^/]+$" } },
    "startUrl": { "type": "string", "pattern": "^https?://[^?#]+$" },
    "desktopAdapter": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "auth", "requests"],
      "properties": {
        "kind": { "const": "http" },
        "auth": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "none" } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "env"], "properties": { "kind": { "enum": ["bearer-env", "cookie-env"] }, "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" } } }
          ]
        },
        "requests": {
          "type": "array", "minItems": 1, "maxItems": 10,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "method", "url"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 100 },
              "method": { "enum": ["GET", "POST"] },
              "url": { "type": "string", "pattern": "^https?://[^?#]+$" },
              "query": { "$ref": "#/$defs/httpValues" },
              "jsonBody": { "$ref": "#/$defs/httpValues" }
            }
          }
        }
      }
    },
    "sourceSessionId": { "type": "string" },
    "createdAt": { "type": "number", "minimum": 0 }
  },
  "$defs": {
    "httpValues": {
      "type": "object", "maxProperties": 100,
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    }
  }
}
