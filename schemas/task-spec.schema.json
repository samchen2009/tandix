{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceforge.dev/schemas/task-spec.v1.json",
  "title": "TraceForge TaskSpec",
  "description": "A parameterized, verifiable task compiled from a TraceForge browser recording.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "description", "source", "parameters", "preconditions", "steps", "success", "policy"],
  "properties": {
    "schemaVersion": { "const": "traceforge.task/v1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["recordingId", "compiler", "compiledAt"],
      "properties": {
        "recordingId": { "type": "string" }, "compiler": { "type": "string" }, "compiledAt": { "type": "number" }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "required"],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["string", "secret", "number", "boolean"] },
          "required": { "type": "boolean" },
          "description": { "type": "string" },
          "default": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "preconditions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "properties": {
          "id": { "type": "string" },
          "action": { "enum": ["navigate", "click", "fill", "select", "press", "submit", "verify"] },
          "selector": { "type": "string" }, "url": { "type": "string" }, "value": { "type": "string" },
          "key": { "type": "string" }, "sensitive": { "type": "boolean" },
          "assertion": { "$ref": "#/$defs/assertion" }
        }
      }
    },
    "success": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
    "policy": {
      "type": "object",
      "required": ["allowedOrigins", "timeoutMs", "repair"],
      "properties": {
        "allowedOrigins": { "type": "array", "items": { "type": "string" } },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "repair": { "enum": ["disabled", "agent"] }
      }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["url", "element", "text"] },
        "matches": { "type": "string" }, "selector": { "type": "string" },
        "state": { "enum": ["visible", "hidden", "enabled", "disabled"] },
        "contains": { "type": "string" }
      }
    }
  }
}
